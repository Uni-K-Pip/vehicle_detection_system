# Normalize text files in the repository.
* text=auto

# Keep source and documentation files stable across Windows and Linux.
.gitattributes text eol=lf
.gitignore text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.xml text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.h text eol=lf
*.py text eol=lf
*.launch.py text eol=lf

# Treat point cloud data and media as binary.
*.pcd binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.mp4 binary
*.zip binary
